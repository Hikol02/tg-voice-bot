# Telegram API Credentials (https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_PHONE_NUMBER=+79991234567
TELEGRAM_SESSION_NAME=voice_transcriber_session

# Настройки прокси
PROXY_ENABLED=True
# Выберите: MTPROTO или SOCKS5
PROXY_TYPE=MTPROTO

# Автоматический перехват динамического secret и port из systemd сервиса tg-ws-proxy
AUTO_FETCH_PROXY_SECRET=True
TG_WS_PROXY_SERVICE=tg-ws-proxy.service

# Если MTPROTO (используются как запасные, если автоподхват выключен):
MTPROTO_HOST=127.0.0.1
MTPROTO_PORT=1443
MTPROTO_SECRET=dd705ef901017a8caa3ed04d10cdb7b2e8

# Если SOCKS5:
SOCKS_HOST=127.0.0.1
SOCKS_PORT=10808
SOCKS_USERNAME=
SOCKS_PASSWORD=

# Модель STT Whisper
# Размеры: tiny, base, small (рекомендуется), medium, turbo, large-v3
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=True
WHISPER_DOWNLOAD_DIR=./models

# Поведение
ACTION_MODE=edit
QUOTE_HEADER=
PROCESS_ROUND_VIDEOS=True
NOTIFY_IF_EMPTY=False
LOG_LEVEL=INFO
